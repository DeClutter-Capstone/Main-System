# Backend environment variables — copy to backend/.env for local dev,
# or set these in the Railway service "Variables" tab for production.

# --- Database ---------------------------------------------------------------
# In production prefer the single DATABASE_URL that Railway's Postgres plugin
# provides (it overrides the DB_* parts below). "postgres://" is normalised
# to "postgresql://" automatically.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=DeClutter

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-...

# --- Generation allowlist (OpenAI token protection) -------------------------
# Comma-separated emails and/or Firebase UIDs allowed to call the generate
# endpoint. FAIL-CLOSED: if empty, nobody can generate.
ALLOWED_GENERATION_EMAILS=you@example.com

# --- Storage ----------------------------------------------------------------
# Uploaded/generated images. Railway's filesystem is ephemeral, so in
# production point this at a mounted volume (e.g. /data/storage) or images are
# lost on every restart/redeploy. Defaults to backend/storage locally.
# STORAGE_DIR=/data/storage

# --- CORS -------------------------------------------------------------------
# Comma-separated allowed frontend origins. "*" for local dev; set your real
# frontend URL in production (required — credentials can't be used with "*").
# ALLOWED_ORIGINS=https://your-frontend.up.railway.app
ALLOWED_ORIGINS=*

# --- Misc -------------------------------------------------------------------
# Log every SQL statement (verbose; keep false in production).
SQL_ECHO=false
