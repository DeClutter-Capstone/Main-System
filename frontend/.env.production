# Production build config (committed on purpose).
# Firebase WEB keys are public by design — they ship in the browser bundle of
# every Firebase app and are secured by Firebase Auth rules + authorized
# domains, not by secrecy. The only real secrets (OPENAI_API_KEY, DATABASE_URL)
# live in Railway variables and are never committed.

# Empty = frontend talks to the SAME origin it is served from (e.g. /api).
# Because the backend serves the frontend, there is no separate backend URL.
VITE_BACKEND_URL=

VITE_FIREBASE_API_KEY=AIzaSyBQnSmQOCY4LskCGJclYRzbtwecMTb-9Ew
VITE_FIREBASE_AUTH_DOMAIN=declutter-c6dfb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=declutter-c6dfb
VITE_FIREBASE_STORAGE_BUCKET=declutter-c6dfb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=339825705387
VITE_FIREBASE_APP_ID=1:339825705387:web:6572473554c5f2ab9252ee
VITE_FIREBASE_MEASUREMENT_ID=G-30NF65HJN3
